# Скопируйте в .env и задайте значения. Файл .env в git не попадает.
GITLAB_HOSTNAME=gitlab.example.org
# https включает Let's Encrypt: нужен публичный домен с открытыми 80/443, либо свои сертификаты
GITLAB_EXTERNAL_URL=http://gitlab.example.org
GITLAB_HTTP_PORT=80
GITLAB_HTTPS_PORT=443
GITLAB_SSH_PORT=2222
SONAR_PORT=9000
SONAR_DB_PASSWORD=change-me
GITLAB_ROOT_PASSWORD=change-me-long-password
GITLAB_IMAGE=gitlab/gitlab-ce:17.5.2-ce.0
RUNNER_IMAGE=gitlab/gitlab-runner:v17.5.2
SONAR_IMAGE=sonarqube:10.6-community
POSTGRES_IMAGE=postgres:15-alpine
# версия плагина: https://github.com/1c-syntax/sonar-bsl-plugin-community/releases
SONAR_BSL_PLUGIN_VERSION=1.15.0
